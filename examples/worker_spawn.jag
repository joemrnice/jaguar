/* A single background job on its own OS thread, notified via .on("done").
   Run with:
     jag run worker_spawn.jag
*/
fun heavyComputation(): num {
    var total: num = 0;
    var i: num = 0;
    loop (i < 500000) {
        total += i;
        i += 1;
    }
    return total;
}

var w: Worker = worker.spawn(fun(): num {
    return heavyComputation();
});

w.on("done", fun(result: data) {
    live.on("worker finished:");
    live.on(result);
});
