/* A fixed-size pool of OS threads (real pthreads) processing CPU-bound
   jobs in parallel, with results collected via onAll(). Run with:
     jag run worker_pool.jag
*/
fun heavyComputation(): num {
    var total: num = 0;
    var i: num = 0;
    loop (i < 200000) {
        total += i;
        i += 1;
    }
    return total;
}

var pool: Worker = worker.pool(4);
pool.submit(fun(): num { return heavyComputation(); });
pool.submit(fun(): num { return heavyComputation(); });
pool.submit(fun(): num { return heavyComputation(); });
pool.submit(fun(): num { return heavyComputation(); });

pool.onAll(fun(results: list<num>) {
    live.on("worker pool results:");
    live.on(results);
});
